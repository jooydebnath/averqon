[Unit]
Description=Averqon privileged firewall executor
Documentation=file:///opt/averqon/docs/SECURITY.md
After=network-pre.target
Wants=network-pre.target
Before=network.target

[Service]
Type=simple
# PRIVILEGED: programs the kernel firewall. Capability set is bounded to what nft/iptables need.
User=root
Group=root
EnvironmentFile=/etc/averqon/averqon.env
ExecStart=/opt/averqon/venv/bin/averqon serve executor --config /etc/averqon/averqon.yaml
Restart=on-failure
RestartSec=3
RuntimeDirectory=averqon
RuntimeDirectoryMode=0750
StateDirectory=averqon
StateDirectoryMode=0750
UMask=0027
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/averqon /run/averqon
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# nft/iptables need privileged netlink calls, so allow the minimum back:
SystemCallFilter=@network-io @ipc setsockopt getsockopt

[Install]
WantedBy=multi-user.target
